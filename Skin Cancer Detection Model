np\n","import pandas as pd\n","import matplotlib.pyplot as plt\n","import seaborn as sns\n","import tensorflow as tf\n","from tensorflow import keras\n","from tensorflow.keras import layers\n","from scipy.optimize import minimize_scalar\n","from sklearn.model_selection import GroupShuffleSplit\n","from sklearn.metrics import (\n","    classification_report, confusion_matrix, roc_auc_score,\n","    balanced_accuracy_score, precision_recall_curve, auc, roc_curve,\n","    precision_recall_fscore_support,\n",")\n","warnings.filterwarnings('ignore')\n","\n","print(\"TensorFlow:\", tf.__version__)\n","keras.mixed_precision.set_global_policy('mixed_float16')\n","\n","# =============================================================================\n","# 1. DATA\n","# =============================================================================\n","DATA_DIR = '/kaggle/input/datasets/kmader/skin-cancer-mnist-ham10000'\n","if not os.path.exists(os.path.join(DATA_DIR, 'HAM10000_metadata.csv')):\n","    hits = glob.glob('/kaggle/input/**/HAM10000_metadata.csv', recursive=True)\n","    if not hits:\n","        raise FileNotFoundError(\"HAM10000_metadata.csv not found.\")\n","    DATA_DIR = os.path.dirname(hits[0])\n","\n","meta = pd.read_csv(os.path.join(DATA_DIR, 'HAM10000_metadata.csv'))\n","img_paths = {}\n","for d in sorted({os.path.dirname(p) for p in\n","                 glob.glob(os.path.join(DATA_DIR, '**', '*.jpg'), recursive=True)}):\n","    for p in glob.glob(os.path.join(d, '*.jpg')):\n","        img_paths[os.path.splitext(os.path.basename(p))[0]] = p\n","\n","meta['path'] = meta['image_id'].map(img_paths)\n","class_names = ['akiec', 'bcc', 'bkl', 'df', 'nv', 'vasc', 'mel']\n","meta['label'] = meta['dx'].map({c: i for i, c in enumerate(class_names)})\n","meta = meta.dropna(subset=['path']).reset_index(drop=True)\n","\n","NV_IDX = class_names.index('nv')\n","MEL_IDX = class_names.index('mel')\n","NUM_CLASSES = 7\n","print(f\"Images: {len(meta)}\")\n","\n","# =============================================================================\n","# 2. LESION-LEVEL SPLIT\n","# =============================================================================\n","gss1 = GroupShuffleSplit(n_splits=1, test_size=0.30, random_state=42)\n","train_idx, temp_idx = next(gss1.split(meta, groups=meta['lesion_id']))\n","temp_meta = meta.iloc[temp_idx].reset_index(drop=True)\n","gss2 = GroupShuffleSplit(n_splits=1, test_size=0.50, random_state=42)\n","val_idx, test_idx = next(gss2.split(temp_meta, groups=temp_meta['lesion_id']))\n","\n","train_df = meta.iloc[train_idx].reset_index(drop=True)\n","val_df   = temp_meta.iloc[val_idx].reset_index(drop=True)\n","test_df  = temp_meta.iloc[test_idx].reset_index(drop=True)\n","print(f\"Train: {len(train_df)} | Val: {len(val_df)} | Test: {len(test_df)}\")\n","\n","# =============================================================================\n","# 3. TF.DATA PIPELINE — HYBRID SAMPLING (50% equal / 50% natural)\n","# =============================================================================\n","IMG_SIZE = (300, 300)\n","BATCH_SIZE = 24\n","AUTOTUNE = tf.data.AUTOTUNE\n","\n","def decode_img(path, label7, label_bin):\n","    img = tf.io.read_file(path)\n","    img = tf.image.decode_jpeg(img, channels=3)\n","    img = tf.image.convert_image_dtype(img, tf.float32)\n","    img = tf.image.resize(img, IMG_SIZE, method='bilinear')\n","    return img, (label7, label_bin)\n","\n","def augment_mild(img, labels):\n","    label7, label_bin = labels\n","    img = tf.image.random_flip_left_right(img)\n","    img = tf.image.random_flip_up_down(img)\n","    return img, (label7, label_bin)\n","\n","def make_per_class_dataset(df_cls):\n","    labels7 = tf.one_hot(df_cls['label'].values, depth=NUM_CLASSES)\n","    labels_bin = tf.cast(tf.equal(df_cls['label'].values, MEL_IDX), tf.float32)\n","    ds = tf.data.Dataset.from_tensor_slices(\n","        (df_cls['path'].values, labels7, labels_bin)\n","    )\n","    ds = ds.shuffle(max(len(df_cls), 32), reshuffle_each_iteration=True)\n","    ds = ds.map(decode_img, num_parallel_calls=AUTOTUNE)\n","    ds = ds.map(augment_mild, num_parallel_calls=AUTOTUNE)\n","    return ds.repeat()\n","\n","class_subsets = [train_df[train_df['label'] == c].reset_index(drop=True)\n","                 for c in range(NUM_CLASSES)]\n","class_sizes = np.array([max(len(s), 1) for s in class_subsets], dtype=np.float32)\n","\n","natural_prior = class_sizes / class_sizes.sum()\n","equal_prior = np.ones(NUM_CLASSES, dtype=np.float32) / NUM_CLASSES\n","sampling_weights = 0.5 * equal_prior + 0.5 * natural_prior\n","\n","print(\"\\nHybrid sampling weights (50% equal + 50% natural):\")\n","for name, w in zip(class_names, sampling_weights):\n","    print(f\"  {name:6s}: {w:.4f}   (raw count: {int(class_sizes[class_names.index(name)])})\")\n","\n","class_datasets = [make_per_class_dataset(s) for s in class_subsets]\n","STEPS_PER_EPOCH = max(len(train_df) // BATCH_SIZE, 50)\n","\n","train_ds = tf.data.Dataset.sample_from_datasets(\n","    class_datasets, weights=sampling_weights\n",").batch(BATCH_SIZE, drop_remainder=True).prefetch(AUTOTUNE)\n","\n","def make_eval_ds(df):\n","    labels7 = tf.one_hot(df['label'].values, depth=NUM_CLASSES)\n","    labels_bin = tf.cast(tf.equal(df['label'].values, MEL_IDX), tf.float32)\n","    ds = tf.data.Dataset.from_tensor_slices((df['path'].values, labels7, labels_bin))\n","    ds = ds.map(decode_img, num_parallel_calls=AUTOTUNE)\n","    ds = ds.batch(BATCH_SIZE)\n","    return ds.prefetch(AUTOTUNE)\n","\n","val_ds  = make_eval_ds(val_df)\n","test_ds = make_eval_ds(test_df)\n","\n","# =============================================================================\n","# 4. METRICS\n","# =============================================================================\n","class BalancedAccuracy(keras.metrics.Metric):\n","    def __init__(self, num_classes=NUM_CLASSES, name='bal_acc', **kwargs):\n","        super().__init__(name=name, **kwargs)\n","        self.num_classes = num_classes\n","        self.confusion = self.add_weight(name='confusion',\n","            shape=(num_classes, num_classes), initializer='zeros')\n","    def update_state(self, y_true, y_pred, sample_weight=None):\n","        yt = tf.argmax(y_true, axis=-1); yp = tf.argmax(y_pred, axis=-1)\n","        cm = tf.math.confusion_matrix(yt, yp, num_classes=self.num_classes,\n","                                       dtype=tf.float32)\n","        self.confusion.assign_add(cm)\n","    def result(self):\n","        diag = tf.linalg.diag_part(self.confusion)\n","        rows = tf.reduce_sum(self.confusion, axis=1)\n","        return tf.reduce_mean(tf.math.divide_no_nan(diag, rows))\n","    def reset_state(self):\n","        self.confusion.assign(tf.zeros_like(self.confusion))\n","\n","# =============================================================================\n","# 5. MODEL — reduced capacity, stronger dropout\n","# =============================================================================\n","inputs = layers.Input(shape=(*IMG_SIZE, 3))\n","x = layers.Rescaling(255.0)(inputs)\n","base_model = tf.keras.applications.EfficientNetB3(\n","    include_top=False, weights='imagenet', input_shape=(*IMG_SIZE, 3)\n",")\n","base_model.trainable = False\n","x = base_model(x, training=False)\n","x = layers.GlobalAveragePooling2D()(x)\n","x = layers.BatchNormalization()(x)\n","shared = layers.Dropout(0.35)(x)\n","\n","h7 = layers.Dense(96, activation='relu')(shared)\n","h7 = layers.BatchNormalization()(h7)\n","h7 = layers.Dropout(0.60)(h7)\n","out7 = layers.Dense(NUM_CLASSES, activation='softmax',\n","                    name='class7', dtype='float32')(h7)\n","\n","hb = layers.Dense(64, activation='relu')(shared)\n","hb = layers.Dropout(0.50)(hb)\n","outb = layers.Dense(1, activation='sigmoid',\n","                    name='mel_binary', dtype='float32')(hb)\n","\n","model = keras.Model(inputs, [out7, outb])\n","model.compile(\n","    optimizer=keras.optimizers.Adam(learning_rate=1e-3),\n","    loss={\n","        'class7': keras.losses.CategoricalCrossentropy(label_smoothing=0.05),\n","        'mel_binary': keras.losses.BinaryCrossentropy(label_smoothing=0.05),\n","    },\n","    loss_weights={'class7': 1.0, 'mel_binary': 0.5},\n","    metrics={\n","        'class7': ['accuracy', BalancedAccuracy(name='bal_acc')],\n","        'mel_binary': [keras.metrics.AUC(name='auc')],\n","    }\n",")\n","model.summary()\n","\n","# =============================================================================\n","# 6. TRAIN\n","# =============================================================================\n","callbacks = [\n","    keras.callbacks.ModelCheckpoint(\n","        'best_skin_model.keras', monitor='val_class7_accuracy', mode='max',\n","        save_best_only=True, verbose=1\n","    ),\n","    keras.callbacks.EarlyStopping(\n","        monitor='val_class7_accuracy', mode='max',\n","        patience=8, restore_best_weights=True, verbose=1\n","    ),\n","    keras.callbacks.ReduceLROnPlateau(\n","        monitor='val_class7_accuracy', mode='max', factor=0.5,\n","        patience=5, min_lr=1e-6, verbose=1\n","    ),\n","]\n","\n","EPOCHS = 40\n","print(\"\\n===== TRAINING: hybrid sampling, reduced head, stronger dropout =====\")\n","history = model.fit(\n","    train_ds, validation_data=val_ds, steps_per_epoch=STEPS_PER_EPOCH,\n","    epochs=EPOCHS, callbacks=callbacks,\n",")\n","\n","# =============================================================================\n","# 7. LOAD BEST + TTA\n","# =============================================================================\n","best_model = keras.models.load_model(\n","    'best_skin_model.keras', compile=False,\n","    custom_objects={'BalancedAccuracy': BalancedAccuracy}\n",")\n","\n","def predict_tta(model, ds):\n","    p7_all, pb_all = [], []\n","    for imgs, _ in ds:\n","        p7s, pbs = [], []\n","        for flip in [lambda x: x,\n","                     tf.image.flip_left_right,\n","                     tf.image.flip_up_down,\n","                     lambda x: tf.image.flip_left_right(tf.image.flip_up_down(x))]:\n","            p7, pb = model.predict(flip(imgs), verbose=0)\n","            p7s.append(p7); pbs.append(pb)\n","        p7_all.append(np.mean(p7s, axis=0))\n","        pb_all.append(np.mean(pbs, axis=0))\n","    return np.concatenate(p7_all), np.concatenate(pb_all).ravel()\n","\n","print(\"\\nComputing val & test predictions with TTA...\")\n","val_p7_raw,  val_pb_raw  = predict_tta(best_model, val_ds)\n","test_p7_raw, test_pb_raw = predict_tta(best_model, test_ds)\n","val_true  = val_df['label'].values\n","test_true = test_df['label'].values\n","\n","# =============================================================================\n","# 8. TEMPERATURE CALIBRATION\n","# =============================================================================\n","def apply_temperature(probs, T):\n","    logits = np.log(np.clip(probs, 1e-9, 1.0)) / T\n","    exp = np.exp(logits - logits.max(axis=1, keepdims=True))\n","    return exp / exp.sum(axis=1, keepdims=True)\n","\n","def find_best_temperature(probs, y_true):\n","    def nll(T):\n","        cal = apply_temperature(probs, T)\n","        return -np.mean(np.log(cal[np.arange(len(y_true)), y_true] + 1e-9))\n","    return float(minimize_scalar(nll, bounds=(0.5, 2.0), method='bounded').x)\n","\n","T_opt = find_best_temperature(val_p7_raw, val_true)\n","print(f\"\\nOptimal temperature: T = {T_opt:.3f}\")\n","val_p7  = apply_temperature(val_p7_raw,  T_opt)\n","test_p7 = apply_temperature(test_p7_raw, T_opt)\n","\n","# =============================================================================\n","# 9. FUSE with mel binary head\n","# =============================================================================\n","BETA = 0.25\n","def fuse_mel(p7, pb, beta=BETA):\n","    fused = p7.copy()\n","    fused[:, MEL_IDX] = (1 - beta) * p7[:, MEL_IDX] + beta * pb\n","    return fused / fused.sum(axis=1, keepdims=True)\n","\n","val_p7_fused  = fuse_mel(val_p7,  val_pb_raw)\n","test_p7_fused = fuse_mel(test_p7, test_pb_raw)\n","\n","# =============================================================================\n","# 10. NV PRIOR CORRECTION\n","# =============================================================================\n","def apply_prior_boost(probs, boost):\n","    corrected = probs.copy()\n","    corrected[:, NV_IDX] *= boost\n","    return corrected / corrected.sum(axis=1, keepdims=True)\n","\n","print(\"\\n--- Tuning nv prior correction on validation ---\")\n","best_boost, best_val_acc = 1.0, (np.argmax(val_p7_fused, axis=1) == val_true).mean()\n","print(f\"  boost=1.00 (baseline): val_acc={best_val_acc:.4f}\")\n","\n","for boost in np.arange(0.90, 2.00, 0.05):\n","    corrected = apply_prior_boost(val_p7_fused, boost)\n","    pred = np.argmax(corrected, axis=1)\n","    acc = (pred == val_true).mean()\n","    mel_auc = roc_auc_score(val_true == MEL_IDX, corrected[:, MEL_IDX])\n","    if acc > best_val_acc:\n","        best_val_acc, best_boost = acc, boost\n","        print(f\"  boost={boost:.2f}: val_acc={acc:.4f}  mel_auc={mel_auc:.4f}  ← new best\")\n","\n","print(f\"\\n✅ Best nv boost: {best_boost:.2f}  →  val accuracy: {best_val_acc:.4f}\")\n","\n","val_p7_final  = apply_prior_boost(val_p7_fused,  best_boost)\n","test_p7_final = apply_prior_boost(test_p7_fused, best_boost)\n","\n","print(\"\\n--- Sanity check: predicted class distribution on VAL (post-correction) ---\")\n","val_pred = np.argmax(val_p7_final, axis=1)\n","for i, name in enumerate(class_names):\n","    pred_n, actual_n = (val_pred == i).sum(), (val_true == i).sum()\n","    ratio = pred_n / max(actual_n, 1)\n","    flag = \"✅\" if 0.7 <= ratio <= 1.4 else \"⚠️\"\n","    print(f\"  {name:6s}: predicted {pred_n:4d} / actual {actual_n:4d} (ratio {ratio:.2f}) {flag}\")\n","print(f\"  Val accuracy: {(val_pred == val_true).mean():.4f}\")\n","\n","# =============================================================================\n","# 11. TEST EVALUATION (default argmax)\n","# =============================================================================\n","test_pred = np.argmax(test_p7_final, axis=1)\n","acc       = (test_pred == test_true).mean()\n","bal_acc   = balanced_accuracy_score(test_true, test_pred)\n","macro_auc = roc_auc_score(test_true, test_p7_final, multi_class='ovr', average='macro')\n","per_class_auc = roc_auc_score(test_true, test_p7_final, multi_class='ovr', average=None)\n","\n","print(\"\\n\" + \"=\"*65)\n","print(\"TEST RESULTS — Default argmax (fused + TTA + calibrated + corrected)\")\n","print(\"=\"*65)\n","print(f\"Accuracy:          {acc:.4f}\")\n","print(f\"Balanced Accuracy: {bal_acc:.4f}\")\n","print(f\"Macro AUC-ROC:     {macro_auc:.4f}\")\n","print(\"\\nPer-class AUC-ROC:\")\n","for name, a in zip(class_names, per_class_auc):\n","    print(f\"  {name:6s}: {a:.4f}\")\n","print(\"\\nClassification Report:\")\n","print(classification_report(test_true, test_pred,\n","                             target_names=class_names, digits=4))\n","\n","# =============================================================================\n","# 12. MELANOMA THRESHOLD — Youden's J\n","# =============================================================================\n","fpr, tpr, thresholds = roc_curve(val_true == MEL_IDX, val_p7_final[:, MEL_IDX])\n","youden_j = tpr - fpr\n","best_idx = int(np.argmax(youden_j))\n","best_thresh = float(thresholds[best_idx])\n","\n","print(\"\\n\" + \"=\"*65)\n","print(\"MELANOMA THRESHOLD (Youden's J on val, corrected probs)\")\n","print(\"=\"*65)\n","print(f\"Threshold: {best_thresh:.3f}\")\n","print(f\"Val sensitivity: {tpr[best_idx]:.3f} | Val specificity: {1-fpr[best_idx]:.3f}\")\n","print(f\"Val Youden J: {youden_j[best_idx]:.3f}\")\n","\n","test_pred_tuned = test_pred.copy()\n","test_pred_tuned[test_p7_final[:, MEL_IDX] >= best_thresh] = MEL_IDX\n","\n","acc_t     = (test_pred_tuned == test_true).mean()\n","bal_acc_t = balanced_accuracy_score(test_true, test_pred_tuned)\n","mel_recall_t = np.sum((test_pred_tuned == MEL_IDX) & (test_true == MEL_IDX)) / np.sum(test_true == MEL_IDX)\n","mel_prec_t   = np.sum((test_pred_tuned == MEL_IDX) & (test_true == MEL_IDX)) / max(np.sum(test_pred_tuned == MEL_IDX), 1)\n","\n","print(\"\\n=== TEST at tuned melanoma operating point ===\")\n","print(f\"Accuracy:             {acc_t:.4f}\")\n","print(f\"Balanced Accuracy:    {bal_acc_t:.4f}\")\n","print(f\"Melanoma Sensitivity: {mel_recall_t:.4f}\")\n","print(f\"Melanoma Precision:   {mel_prec_t:.4f}\")\n","\n","# =============================================================================\n","# 13. VISUALISATIONS\n","# =============================================================================\n","plt.figure(figsize=(10, 8))\n","sns.heatmap(confusion_matrix(test_true, test_pred), annot=True, fmt='d',\n","            cmap='Blues', xticklabels=class_names, yticklabels=class_names)\n","plt.title(f'Test Confusion Matrix (Acc={acc:.3f})')\n","plt.xlabel('Predicted'); plt.ylabel('True'); plt.tight_layout(); plt.show()\n","\n","plt.figure(figsize=(10, 8))\n","for i, name in enumerate(class_names):\n","    prec, rec, _ = precision_recall_curve(test_true == i, test_p7_final[:, i])\n","    plt.plot(rec, prec, label=f'{name} (PR-AUC={auc(rec, prec):.3f})')\n","plt.xlabel('Recall'); plt.ylabel('Precision')\n","plt.title('Per-Class PR Curves (Test, final probabilities)')\n","plt.legend(); plt.grid(alpha=0.3); plt.tight_layout(); plt.show()\n","\n","fig, axes = plt.subplots(1, 3, figsize=(18, 5))\n","h = history.history; ep = range(1, len(h['class7_accuracy']) + 1)\n","axes[0].plot(ep, h['class7_accuracy'], 'b-', label='Train')\n","axes[0].plot(ep, h['val_class7_accuracy'], 'r-', label='Val')\n","axes[0].set_title('Accuracy'); axes[0].legend()\n","axes[1].plot(ep, h['class7_bal_acc'], 'b-', label='Train')\n","axes[1].plot(ep, h['val_class7_bal_acc'], 'r-', label='Val')\n","axes[1].set_title('Balanced accuracy'); axes[1].legend()\n","axes[2].plot(ep, h['mel_binary_auc'], 'b-', label='Train')\n","axes[2].plot(ep, h['val_mel_binary_auc'], 'r-', label='Val')\n","axes[2].set_title('Melanoma binary AUC'); axes[2].legend()\n","plt.tight_layout(); plt.show()\n","\n","# =============================================================================\n","# 14. FINAL SUMMARY (console)\n","# =============================================================================\n","print(\"\\n\" + \"=\"*65)\n","print(\"FINAL SUMMARY\")\n","print(\"=\"*65)\n","print(f\"Test Accuracy (default argmax):   {acc:.4f}\")\n","print(f\"Test Balanced Accuracy:           {bal_acc:.4f}\")\n","print(f\"Test Macro AUC-ROC:               {macro_auc:.4f}\")\n","print(f\"Melanoma AUC-ROC:                 {per_class_auc[MEL_IDX]:.4f}\")\n","print(f\"Melanoma Recall (default argmax): {(test_pred == MEL_IDX)[test_true == MEL_IDX].mean():.4f}\")\n","print(f\"Melanoma Recall (tuned, J={best_thresh:.2f}): {mel_recall_t:.4f}\")\n","print(f\"Melanoma Precision (tuned):       {mel_prec_t:.4f}\")\n","print(f\"Optimal temperature T:            {T_opt:.3f}\")\n","print(f\"Optimal nv boost:                 {best_boost:.2f}\")\n","\n","# =============================================================================\n","# 15. EXPORT ALL EVALUATION METRICS TO CSV  ✅ NEW\n","# =============================================================================\n","print(\"\\n\" + \"=\"*65)\n","print(\"EXPORTING ALL EVALUATION METRICS TO CSV\")\n","print(\"=\"*65)\n","\n","# ---- helper ----\n","_metric_rows = []\n","def _add(section, metric, value, cls=''):\n","    _metric_rows.append({'section': section, 'metric': metric,\n","                         'class': cls, 'value': value})\n","\n","# ------- (a) training config -------\n","_add('config', 'img_size',             'x'.join(map(str, IMG_SIZE)))\n","_add('config', 'batch_size',           BATCH_SIZE)\n","_add('config', 'backbone',             'EfficientNetB3')\n","_add('config', 'sampling',             'hybrid (0.5 equal + 0.5 natural)')\n","_add('config', 'epochs_requested',     EPOCHS)\n","_add('config', 'epochs_run',           len(history.history['class7_accuracy']))\n","_add('config', 'n_train',              len(train_df))\n","_add('config', 'n_val',                len(val_df))\n","_add('config', 'n_test',               len(test_df))\n","\n","# ------- (b) calibration & tuning params -------\n","_add('calibration', 'temperature',        float(T_opt))\n","_add('calibration', 'nv_prior_boost',     float(best_boost))\n","_add('calibration', 'mel_fusion_beta',    float(BETA))\n","\n","# ------- (c) validation metrics (default argmax, post-correction) -------\n","val_macro_auc     = roc_auc_score(val_true, val_p7_final,\n","                                  multi_class='ovr', average='macro')\n","val_per_class_auc = roc_auc_score(val_true, val_p7_final,\n","                                  multi_class='ovr', average=None)\n","val_bal_acc       = balanced_accuracy_score(val_true, val_pred)\n","\n","_add('val_default', 'accuracy',          float((val_pred == val_true).mean()))\n","_add('val_default', 'balanced_accuracy', float(val_bal_acc))\n","_add('val_default', 'macro_auc_roc',     float(val_macro_auc))\n","\n","val_prec, val_rec, val_f1, val_sup = precision_recall_fscore_support(\n","    val_true, val_pred, labels=list(range(NUM_CLASSES)), zero_division=0)\n","for i, name in enumerate(class_names):\n","    _add('val_per_class', 'auc_roc',   float(val_per_class_auc[i]), name)\n","    _add('val_per_class', 'precision', float(val_prec[i]),         name)\n","    _add('val_per_class', 'recall',    float(val_rec[i]),          name)\n","    _add('val_per_class', 'f1_score',  float(val_f1[i]),           name)\n","    _add('val_per_class', 'support',   int(val_sup[i]),            name)\n","\n","# val Youden J details\n","_add('val_youden', 'threshold',   float(best_thresh))\n","_add('val_youden', 'sensitivity', float(tpr[best_idx]))\n","_add('val_youden', 'specificity', float(1 - fpr[best_idx]))\n","_add('val_youden', 'youden_j',    float(youden_j[best_idx]))\n","\n","# ------- (d) test metrics (default argmax) -------\n","_add('test_default', 'accuracy',          float(acc))\n","_add('test_default', 'balanced_accuracy', float(bal_acc))\n","_add('test_default', 'macro_auc_roc',     float(macro_auc))\n","\n","test_prec, test_rec, test_f1, test_sup = precision_recall_fscore_support(\n","    test_true, test_pred, labels=list(range(NUM_CLASSES)), zero_division=0)\n","for i, name in enumerate(class_names):\n","    p_i, r_i, _ = precision_recall_curve(test_true == i, test_p7_final[:, i])\n","    _add('test_per_class', 'auc_roc',   float(per_class_auc[i]), name)\n","    _add('test_per_class', 'pr_auc',    float(auc(r_i, p_i)),    name)\n","    _add('test_per_class', 'precision', float(test_prec[i]),     name)\n","    _add('test_per_class', 'recall',    float(test_rec[i]),      name)\n","    _add('test_per_class', 'f1_score',  float(test_f1[i]),       name)\n","    _add('test_per_class', 'support',   int(test_sup[i]),        name)\n","\n","# ------- (e) test confusion matrix (default argmax) -------\n","cm_test = confusion_matrix(test_true, test_pred, labels=list(range(NUM_CLASSES)))\n","for i, tn in enumerate(class_names):\n","    for j, pn in enumerate(class_names):\n","        _add('test_confusion_matrix', f'true_{tn}__pred_{pn}', int(cm_test[i, j]))\n","\n","# ------- (f) test metrics at tuned melanoma threshold -------\n","_add('test_tuned_mel', 'threshold',            float(best_thresh))\n","_add('test_tuned_mel', 'accuracy',             float(acc_t))\n","_add('test_tuned_mel', 'balanced_accuracy',    float(bal_acc_t))\n","_add('test_tuned_mel', 'melanoma_sensitivity', float(mel_recall_t))\n","_add('test_tuned_mel', 'melanoma_precision',   float(mel_prec_t))\n","\n","# ------- (g) training history summary -------\n","h = history.history\n","_add('history', 'best_train_accuracy', float(max(h['class7_accuracy'])))\n"