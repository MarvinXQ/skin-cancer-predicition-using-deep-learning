{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.12.13","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"nvidiaTeslaT4","dataSources":[{"sourceType":"datasetVersion","sourceId":104884}],"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"# =============================================================================\n# HAM10000 SKIN CANCER DETECTION – FINAL PRODUCTION PIPELINE\n# EfficientNetB3 @ 300 | Hybrid sampling | Reduced capacity | TTA\n# Calibrated | NV prior correction | Youden J | Dual-head\n# =============================================================================\n\n!pip install -q tensorflow matplotlib seaborn scikit-learn scipy\n\nimport os, glob, warnings\nimport numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\nimport seaborn as sns\nimport tensorflow as tf\nfrom tensorflow import keras\nfrom tensorflow.keras import layers\nfrom scipy.optimize import minimize_scalar\nfrom sklearn.model_selection import GroupShuffleSplit\nfrom sklearn.metrics import (\n    classification_report, confusion_matrix, roc_auc_score,\n    balanced_accuracy_score, precision_recall_curve, auc, roc_curve\n)\nwarnings.filterwarnings('ignore')\n\nprint(\"TensorFlow:\", tf.__version__)\nkeras.mixed_precision.set_global_policy('mixed_float16')\n\n# =============================================================================\n# 1. DATA\n# =============================================================================\nDATA_DIR = '/kaggle/input/datasets/kmader/skin-cancer-mnist-ham10000'\nif not os.path.exists(os.path.join(DATA_DIR, 'HAM10000_metadata.csv')):\n    hits = glob.glob('/kaggle/input/**/HAM10000_metadata.csv', recursive=True)\n    if not hits:\n        raise FileNotFoundError(\"HAM10000_metadata.csv not found.\")\n    DATA_DIR = os.path.dirname(hits[0])\n\nmeta = pd.read_csv(os.path.join(DATA_DIR, 'HAM10000_metadata.csv'))\nimg_paths = {}\nfor d in sorted({os.path.dirname(p) for p in\n                 glob.glob(os.path.join(DATA_DIR, '**', '*.jpg'), recursive=True)}):\n    for p in glob.glob(os.path.join(d, '*.jpg')):\n        img_paths[os.path.splitext(os.path.basename(p))[0]] = p\n\nmeta['path'] = meta['image_id'].map(img_paths)\nclass_names = ['akiec', 'bcc', 'bkl', 'df', 'nv', 'vasc', 'mel']\nmeta['label'] = meta['dx'].map({c: i for i, c in enumerate(class_names)})\nmeta = meta.dropna(subset=['path']).reset_index(drop=True)\n\nNV_IDX = class_names.index('nv')\nMEL_IDX = class_names.index('mel')\nNUM_CLASSES = 7\nprint(f\"Images: {len(meta)}\")\n\n# =============================================================================\n# 2. LESION-LEVEL SPLIT\n# =============================================================================\ngss1 = GroupShuffleSplit(n_splits=1, test_size=0.30, random_state=42)\ntrain_idx, temp_idx = next(gss1.split(meta, groups=meta['lesion_id']))\ntemp_meta = meta.iloc[temp_idx].reset_index(drop=True)\ngss2 = GroupShuffleSplit(n_splits=1, test_size=0.50, random_state=42)\nval_idx, test_idx = next(gss2.split(temp_meta, groups=temp_meta['lesion_id']))\n\ntrain_df = meta.iloc[train_idx].reset_index(drop=True)\nval_df   = temp_meta.iloc[val_idx].reset_index(drop=True)\ntest_df  = temp_meta.iloc[test_idx].reset_index(drop=True)\nprint(f\"Train: {len(train_df)} | Val: {len(val_df)} | Test: {len(test_df)}\")\n\n# =============================================================================\n# 3. TF.DATA PIPELINE — HYBRID SAMPLING (50% equal / 50% natural)\n# =============================================================================\nIMG_SIZE = (300, 300)\nBATCH_SIZE = 24\nAUTOTUNE = tf.data.AUTOTUNE\n\n# Tuple fix from last run — return (img, (label7, label_bin))\ndef decode_img(path, label7, label_bin):\n    img = tf.io.read_file(path)\n    img = tf.image.decode_jpeg(img, channels=3)\n    img = tf.image.convert_image_dtype(img, tf.float32)\n    img = tf.image.resize(img, IMG_SIZE, method='bilinear')\n    return img, (label7, label_bin)\n\ndef augment_mild(img, labels):\n    label7, label_bin = labels\n    img = tf.image.random_flip_left_right(img)\n    img = tf.image.random_flip_up_down(img)\n    return img, (label7, label_bin)\n\ndef make_per_class_dataset(df_cls):\n    labels7 = tf.one_hot(df_cls['label'].values, depth=NUM_CLASSES)\n    labels_bin = tf.cast(tf.equal(df_cls['label'].values, MEL_IDX), tf.float32)\n    ds = tf.data.Dataset.from_tensor_slices(\n        (df_cls['path'].values, labels7, labels_bin)\n    )\n    ds = ds.shuffle(max(len(df_cls), 32), reshuffle_each_iteration=True)\n    ds = ds.map(decode_img, num_parallel_calls=AUTOTUNE)\n    ds = ds.map(augment_mild, num_parallel_calls=AUTOTUNE)\n    return ds.repeat()\n\nclass_subsets = [train_df[train_df['label'] == c].reset_index(drop=True)\n                 for c in range(NUM_CLASSES)]\nclass_sizes = np.array([max(len(s), 1) for s in class_subsets], dtype=np.float32)\n\nnatural_prior = class_sizes / class_sizes.sum()\nequal_prior = np.ones(NUM_CLASSES, dtype=np.float32) / NUM_CLASSES\nsampling_weights = 0.5 * equal_prior + 0.5 * natural_prior      # ← hybrid\n\nprint(\"\\nHybrid sampling weights (50% equal + 50% natural):\")\nfor name, w in zip(class_names, sampling_weights):\n    print(f\"  {name:6s}: {w:.4f}   (raw count: {int(class_sizes[class_names.index(name)])})\")\n\nclass_datasets = [make_per_class_dataset(s) for s in class_subsets]\nSTEPS_PER_EPOCH = max(len(train_df) // BATCH_SIZE, 50)\n\ntrain_ds = tf.data.Dataset.sample_from_datasets(\n    class_datasets, weights=sampling_weights\n).batch(BATCH_SIZE, drop_remainder=True).prefetch(AUTOTUNE)\n\ndef make_eval_ds(df):\n    labels7 = tf.one_hot(df['label'].values, depth=NUM_CLASSES)\n    labels_bin = tf.cast(tf.equal(df['label'].values, MEL_IDX), tf.float32)\n    ds = tf.data.Dataset.from_tensor_slices((df['path'].values, labels7, labels_bin))\n    ds = ds.map(decode_img, num_parallel_calls=AUTOTUNE)\n    ds = ds.batch(BATCH_SIZE)\n    return ds.prefetch(AUTOTUNE)\n\nval_ds  = make_eval_ds(val_df)\ntest_ds = make_eval_ds(test_df)\n\n# =============================================================================\n# 4. METRICS\n# =============================================================================\nclass BalancedAccuracy(keras.metrics.Metric):\n    def __init__(self, num_classes=NUM_CLASSES, name='bal_acc', **kwargs):\n        super().__init__(name=name, **kwargs)\n        self.num_classes = num_classes\n        self.confusion = self.add_weight(name='confusion',\n            shape=(num_classes, num_classes), initializer='zeros')\n    def update_state(self, y_true, y_pred, sample_weight=None):\n        yt = tf.argmax(y_true, axis=-1); yp = tf.argmax(y_pred, axis=-1)\n        cm = tf.math.confusion_matrix(yt, yp, num_classes=self.num_classes,\n                                       dtype=tf.float32)\n        self.confusion.assign_add(cm)\n    def result(self):\n        diag = tf.linalg.diag_part(self.confusion)\n        rows = tf.reduce_sum(self.confusion, axis=1)\n        return tf.reduce_mean(tf.math.divide_no_nan(diag, rows))\n    def reset_state(self):\n        self.confusion.assign(tf.zeros_like(self.confusion))\n\n# =============================================================================\n# 5. MODEL — reduced capacity, stronger dropout\n# =============================================================================\ninputs = layers.Input(shape=(*IMG_SIZE, 3))\nx = layers.Rescaling(255.0)(inputs)\nbase_model = tf.keras.applications.EfficientNetB3(\n    include_top=False, weights='imagenet', input_shape=(*IMG_SIZE, 3)\n)\nbase_model.trainable = False\nx = base_model(x, training=False)\nx = layers.GlobalAveragePooling2D()(x)\nx = layers.BatchNormalization()(x)\nshared = layers.Dropout(0.35)(x)\n\n# class7 head — reduced from 128 to 96, stronger dropout\nh7 = layers.Dense(96, activation='relu')(shared)         # was 128\nh7 = layers.BatchNormalization()(h7)\nh7 = layers.Dropout(0.60)(h7)                             # was 0.50\nout7 = layers.Dense(NUM_CLASSES, activation='softmax',\n                    name='class7', dtype='float32')(h7)\n\n# mel binary head — stronger dropout\nhb = layers.Dense(64, activation='relu')(shared)\nhb = layers.Dropout(0.50)(hb)                             # was 0.40\noutb = layers.Dense(1, activation='sigmoid',\n                    name='mel_binary', dtype='float32')(hb)\n\nmodel = keras.Model(inputs, [out7, outb])\nmodel.compile(\n    optimizer=keras.optimizers.Adam(learning_rate=1e-3),\n    loss={\n        'class7': keras.losses.CategoricalCrossentropy(label_smoothing=0.05),\n        'mel_binary': keras.losses.BinaryCrossentropy(label_smoothing=0.05),\n    },\n    loss_weights={'class7': 1.0, 'mel_binary': 0.5},\n    metrics={\n        'class7': ['accuracy', BalancedAccuracy(name='bal_acc')],\n        'mel_binary': [keras.metrics.AUC(name='auc')],\n    }\n)\nmodel.summary()\n\n# =============================================================================\n# 6. TRAIN — tighter early stopping\n# =============================================================================\ncallbacks = [\n    keras.callbacks.ModelCheckpoint(\n        'best_skin_model.keras', monitor='val_class7_accuracy', mode='max',\n        save_best_only=True, verbose=1\n    ),\n    keras.callbacks.EarlyStopping(\n        monitor='val_class7_accuracy', mode='max',\n        patience=8, restore_best_weights=True, verbose=1      # was 15\n    ),\n    keras.callbacks.ReduceLROnPlateau(\n        monitor='val_class7_accuracy', mode='max', factor=0.5,\n        patience=5, min_lr=1e-6, verbose=1                    # was 6\n    ),\n]\n\nEPOCHS = 40\nprint(\"\\n===== TRAINING: hybrid sampling, reduced head, stronger dropout =====\")\nhistory = model.fit(\n    train_ds, validation_data=val_ds, steps_per_epoch=STEPS_PER_EPOCH,\n    epochs=EPOCHS, callbacks=callbacks,\n)\n\n# =============================================================================\n# 7. LOAD BEST + TTA\n# =============================================================================\nbest_model = keras.models.load_model(\n    'best_skin_model.keras', compile=False,\n    custom_objects={'BalancedAccuracy': BalancedAccuracy}\n)\n\ndef predict_tta(model, ds):\n    p7_all, pb_all = [], []\n    for imgs, _ in ds:\n        p7s, pbs = [], []\n        for flip in [lambda x: x,\n                     tf.image.flip_left_right,\n                     tf.image.flip_up_down,\n                     lambda x: tf.image.flip_left_right(tf.image.flip_up_down(x))]:\n            p7, pb = model.predict(flip(imgs), verbose=0)\n            p7s.append(p7); pbs.append(pb)\n        p7_all.append(np.mean(p7s, axis=0))\n        pb_all.append(np.mean(pbs, axis=0))\n    return np.concatenate(p7_all), np.concatenate(pb_all).ravel()\n\nprint(\"\\nComputing val & test predictions with TTA...\")\nval_p7_raw,  val_pb_raw  = predict_tta(best_model, val_ds)\ntest_p7_raw, test_pb_raw = predict_tta(best_model, test_ds)\nval_true  = val_df['label'].values\ntest_true = test_df['label'].values\n\n# =============================================================================\n# 8. TEMPERATURE CALIBRATION\n# =============================================================================\ndef apply_temperature(probs, T):\n    logits = np.log(np.clip(probs, 1e-9, 1.0)) / T\n    exp = np.exp(logits - logits.max(axis=1, keepdims=True))\n    return exp / exp.sum(axis=1, keepdims=True)\n\ndef find_best_temperature(probs, y_true):\n    def nll(T):\n        cal = apply_temperature(probs, T)\n        return -np.mean(np.log(cal[np.arange(len(y_true)), y_true] + 1e-9))\n    return float(minimize_scalar(nll, bounds=(0.5, 2.0), method='bounded').x)\n\nT_opt = find_best_temperature(val_p7_raw, val_true)\nprint(f\"\\nOptimal temperature: T = {T_opt:.3f}\")\nval_p7  = apply_temperature(val_p7_raw,  T_opt)\ntest_p7 = apply_temperature(test_p7_raw, T_opt)\n\n# =============================================================================\n# 9. FUSE with mel binary head (β reduced to 0.25)\n# =============================================================================\nBETA = 0.25                                              # was 0.35\ndef fuse_mel(p7, pb, beta=BETA):\n    fused = p7.copy()\n    fused[:, MEL_IDX] = (1 - beta) * p7[:, MEL_IDX] + beta * pb\n    return fused / fused.sum(axis=1, keepdims=True)\n\nval_p7_fused  = fuse_mel(val_p7,  val_pb_raw)\ntest_p7_fused = fuse_mel(test_p7, test_pb_raw)\n\n# =============================================================================\n# 10. NV PRIOR CORRECTION — tuned on validation accuracy\n#     Fixes the equal-sampling bias where nv was under-predicted (ratio 0.83)\n# =============================================================================\ndef apply_prior_boost(probs, boost):\n    \"\"\"Multiply nv's probability, then renormalize. Preserves other ratios.\"\"\"\n    corrected = probs.copy()\n    corrected[:, NV_IDX] *= boost\n    return corrected / corrected.sum(axis=1, keepdims=True)\n\nprint(\"\\n--- Tuning nv prior correction on validation ---\")\nbest_boost, best_val_acc = 1.0, (np.argmax(val_p7_fused, axis=1) == val_true).mean()\nprint(f\"  boost=1.00 (baseline): val_acc={best_val_acc:.4f}\")\n\nfor boost in np.arange(0.90, 2.00, 0.05):\n    corrected = apply_prior_boost(val_p7_fused, boost)\n    pred = np.argmax(corrected, axis=1)\n    acc = (pred == val_true).mean()\n    mel_auc = roc_auc_score(val_true == MEL_IDX, corrected[:, MEL_IDX])\n    if acc > best_val_acc:\n        best_val_acc, best_boost, best_mel_auc = acc, boost, mel_auc\n        print(f\"  boost={boost:.2f}: val_acc={acc:.4f}  mel_auc={mel_auc:.4f}  ← new best\")\n\nprint(f\"\\n✅ Best nv boost: {best_boost:.2f}  →  val accuracy: {best_val_acc:.4f}\")\n\n# Apply the chosen boost to both val and test\nval_p7_final  = apply_prior_boost(val_p7_fused,  best_boost)\ntest_p7_final = apply_prior_boost(test_p7_fused, best_boost)\n\n# --- Sanity check ---\nprint(\"\\n--- Sanity check: predicted class distribution on VAL (post-correction) ---\")\nval_pred = np.argmax(val_p7_final, axis=1)\nfor i, name in enumerate(class_names):\n    pred_n, actual_n = (val_pred == i).sum(), (val_true == i).sum()\n    ratio = pred_n / max(actual_n, 1)\n    flag = \"✅\" if 0.7 <= ratio <= 1.4 else \"⚠️\"\n    print(f\"  {name:6s}: predicted {pred_n:4d} / actual {actual_n:4d} (ratio {ratio:.2f}) {flag}\")\nprint(f\"  Val accuracy: {(val_pred == val_true).mean():.4f}\")\n\n# =============================================================================\n# 11. TEST EVALUATION (default argmax)\n# =============================================================================\ntest_pred = np.argmax(test_p7_final, axis=1)\nacc       = (test_pred == test_true).mean()\nbal_acc   = balanced_accuracy_score(test_true, test_pred)\nmacro_auc = roc_auc_score(test_true, test_p7_final, multi_class='ovr', average='macro')\nper_class_auc = roc_auc_score(test_true, test_p7_final, multi_class='ovr', average=None)\n\nprint(\"\\n\" + \"=\"*65)\nprint(\"TEST RESULTS — Default argmax (fused + TTA + calibrated + corrected)\")\nprint(\"=\"*65)\nprint(f\"Accuracy:          {acc:.4f}\")\nprint(f\"Balanced Accuracy: {bal_acc:.4f}\")\nprint(f\"Macro AUC-ROC:     {macro_auc:.4f}\")\nprint(\"\\nPer-class AUC-ROC:\")\nfor name, a in zip(class_names, per_class_auc):\n    print(f\"  {name:6s}: {a:.4f}\")\nprint(\"\\nClassification Report:\")\nprint(classification_report(test_true, test_pred,\n                             target_names=class_names, digits=4))\n\n# =============================================================================\n# 12. MELANOMA THRESHOLD — Youden's J on the corrected probs\n# =============================================================================\nfpr, tpr, thresholds = roc_curve(val_true == MEL_IDX, val_p7_final[:, MEL_IDX])\nyouden_j = tpr - fpr\nbest_idx = int(np.argmax(youden_j))\nbest_thresh = float(thresholds[best_idx])\n\nprint(\"\\n\" + \"=\"*65)\nprint(\"MELANOMA THRESHOLD (Youden's J on val, corrected probs)\")\nprint(\"=\"*65)\nprint(f\"Threshold: {best_thresh:.3f}\")\nprint(f\"Val sensitivity: {tpr[best_idx]:.3f} | Val specificity: {1-fpr[best_idx]:.3f}\")\nprint(f\"Val Youden J: {youden_j[best_idx]:.3f}\")\n\ntest_pred_tuned = test_pred.copy()\ntest_pred_tuned[test_p7_final[:, MEL_IDX] >= best_thresh] = MEL_IDX\n\nacc_t     = (test_pred_tuned == test_true).mean()\nbal_acc_t = balanced_accuracy_score(test_true, test_pred_tuned)\nmel_recall_t = np.sum((test_pred_tuned == MEL_IDX) & (test_true == MEL_IDX)) / np.sum(test_true == MEL_IDX)\nmel_prec_t   = np.sum((test_pred_tuned == MEL_IDX) & (test_true == MEL_IDX)) / max(np.sum(test_pred_tuned == MEL_IDX), 1)\n\nprint(\"\\n=== TEST at tuned melanoma operating point ===\")\nprint(f\"Accuracy:             {acc_t:.4f}\")\nprint(f\"Balanced Accuracy:    {bal_acc_t:.4f}\")\nprint(f\"Melanoma Sensitivity: {mel_recall_t:.4f}\")\nprint(f\"Melanoma Precision:   {mel_prec_t:.4f}\")\n\n# =============================================================================\n# 13. VISUALISATIONS\n# =============================================================================\nplt.figure(figsize=(10, 8))\nsns.heatmap(confusion_matrix(test_true, test_pred), annot=True, fmt='d',\n            cmap='Blues', xticklabels=class_names, yticklabels=class_names)\nplt.title(f'Test Confusion Matrix (Acc={acc:.3f})')\nplt.xlabel('Predicted'); plt.ylabel('True'); plt.tight_layout(); plt.show()\n\nplt.figure(figsize=(10, 8))\nfor i, name in enumerate(class_names):\n    prec, rec, _ = precision_recall_curve(test_true == i, test_p7_final[:, i])\n    plt.plot(rec, prec, label=f'{name} (PR-AUC={auc(rec, prec):.3f})')\nplt.xlabel('Recall'); plt.ylabel('